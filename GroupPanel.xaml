<Window x:Class="DesktopGroups.GroupPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopGroups" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Left="-32000" Top="-32000" AllowDrop="True"
        DragOver="Panel_DragOver" DragLeave="Panel_DragLeave" Drop="Panel_Drop">
    <!-- Sizes and colors marked DynamicResource are set from the group's GroupStyle in ApplyStyle(). -->
    <Window.Resources>
        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel Width="{DynamicResource PanelWidth}" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel Width="{DynamicResource PanelWidth}" />
        </ItemsPanelTemplate>

        <Style x:Key="ItemBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="{DynamicResource ItemMargin}" />
            <EventSetter Event="MouseLeftButtonDown" Handler="Item_MouseLeftButtonDown" />
            <EventSetter Event="MouseMove" Handler="Item_MouseMove" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GridItem">
            <Border Style="{StaticResource ItemBorder}" Width="{DynamicResource CellWidth}" Padding="4">
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,4,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListItem">
            <Border Style="{StaticResource ItemBorder}" Padding="6,4">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Frosted glass: the blurred screen snapshot, positioned to line up with the real screen and clipped to the panel.
             In a Canvas so its monitor-sized image never affects the window's size. -->
        <Canvas>
            <Image x:Name="Backdrop" Stretch="Fill" />
        </Canvas>

        <DockPanel Margin="24">
            <StackPanel x:Name="NameArea" DockPanel.Dock="Top" HorizontalAlignment="Center">
                <TextBlock x:Name="GroupName" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" MouseLeftButtonDown="GroupName_MouseLeftButtonDown">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.7" />
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel x:Name="NameEditor" Visibility="Collapsed">
                    <TextBox x:Name="NameBox" FontSize="20" MinWidth="200" Padding="8,2" HorizontalContentAlignment="Center"
                             KeyDown="NameBox_KeyDown" />
                    <TextBlock x:Name="NameProblem" Foreground="#FFB4AB" FontSize="12" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <Grid x:Name="Panel">
                <!-- Back to front: background (fill, edge, shadow), image dim, theme decoration, animated effect, items. -->
                <Border x:Name="PanelBackground" />
                <Border x:Name="PanelOverlay" />
                <Border x:Name="PanelDecoration" />
                <Canvas x:Name="EffectLayer" IsHitTestVisible="False" />
                <StackPanel x:Name="PanelContent">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="420">
                        <ItemsControl x:Name="Items" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" Visibility="Collapsed" Margin="0,16" HorizontalAlignment="Center" Opacity="0.7"
                               FontSize="13" Text="Drop files here to add them" />
                </StackPanel>
                <!-- Shown while something is dragged over the panel: what a drop will do, or why it can't. -->
                <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#B3000000" BorderBrush="#22E4FF" BorderThickness="2">
                    <TextBlock x:Name="DropHintText" Foreground="White" FontSize="13" Margin="16"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
