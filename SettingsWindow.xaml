<Window x:Class="DesktopGroups.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="#16172B" Foreground="#E6E6F0" FontSize="13">
    <Window.Resources>
        <!-- One option of a row: a rounded chip, outlined in neon pink when selected. -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6E6F0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="#262842" BorderBrush="#3A3D5C" BorderThickness="1" CornerRadius="8" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#30335A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#3D1E52" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF2BD9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6F0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="#262842" BorderBrush="#22E4FF" BorderThickness="1" CornerRadius="8" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1C3A4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,16,18,12">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name" Foreground="#9A9CB8" VerticalAlignment="Center" Margin="0,0,0,6" />
            <StackPanel Grid.Column="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Rename" Style="{StaticResource Action}" Click="Rename_Click" />
                    <TextBox x:Name="NameBox" Margin="0,0,6,6" Padding="6,3" Background="#262842" Foreground="#E6E6F0"
                             BorderBrush="#3A3D5C" CaretBrush="#E6E6F0" KeyDown="NameBox_KeyDown" />
                </DockPanel>
                <TextBlock x:Name="NameProblem" Foreground="#FF8A80" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Option rows are built in code from the style choices. -->
        <StackPanel x:Name="Rows" />

        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource Action}" IsCancel="True" Margin="0,0,0,6" />
            <Button Content="Delete group…" Style="{StaticResource Action}" Foreground="#FF8A80" HorizontalAlignment="Left" Click="Delete_Click" />
        </DockPanel>
    </StackPanel>
</Window>
